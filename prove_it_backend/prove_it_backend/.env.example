MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<AppName>
MONGODB_DB_NAME=prove_it

# JWT signing key — generate a long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=<generate-a-long-random-string>

# "development" seeds demo data + enables the topbar role-switcher; any other value
# (e.g. "production") disables both. Defaults to "development" if unset.
ENVIRONMENT=development

# Comma-separated list of origins allowed to call this API (no wildcard — required
# for credentialed requests). Defaults to http://localhost:5173 if unset.
CORS_ALLOWED_ORIGINS=https://pr-tracker-1-ilnn.onrender.com

# Base URL of the deployed frontend — used to build the link inside forgot-password emails.
FRONTEND_URL=<your deployed frontend URL, e.g. http://localhost:5173>

# SMTP credentials used to send forgot-password emails. Gmail: create an App Password at
# https://myaccount.google.com/apppasswords (requires 2FA on the account) — do not use your
# normal Gmail password here. If SMTP_HOST is left unset, the reset link is printed to the
# backend console instead of emailed, so the flow can still be tested locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your gmail address>
SMTP_PASSWORD=<gmail app password>
SMTP_FROM_EMAIL=<your gmail address>
